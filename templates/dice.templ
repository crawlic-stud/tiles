package templates

css diceOverlay() {
	position: fixed;
	bottom: 16px;
	right: 16px;
	z-index: 20000 !important;
}

templ DiceOverlay() {
	<script>
    var selectedDice = {};

    function addDice(dice, count) {
        if (!selectedDice[dice]) {
            selectedDice[dice] = 0;
        }
        selectedDice[dice] += 1;
        var diceString = "";
        for (const [diceType, amount] of Object.entries(selectedDice)) {
            diceString += `${amount}${diceType} `;
        }
        document.getElementById("selected-dice").value = diceString;
    }

    function clearDice() {
        selectedDice = {};
        document.getElementById("selected-dice").value = "";
    }
    </script>
	<!---->
	<div class={ "dice-controls", diceOverlay() }>
		<div data-popup-wrapper class={ "dice-controls-inline", popupWrapper() }>
			<div>
				<div>
					<button class="dice-btn small-btn" onclick="addDice('d4', 1)">+1d4</button>
					<button class="dice-btn small-btn" onclick="addDice('d6', 1)">+1d6</button>
					<button class="dice-btn small-btn" onclick="addDice('d8', 1)">+1d8</button>
					<button class="dice-btn small-btn" onclick="addDice('d10', 1)">+1d10</button>
					<button class="dice-btn small-btn" onclick="addDice('d12', 1)">+1d12</button>
					<button class="dice-btn small-btn" onclick="addDice('d20', 1)">+1d20</button>
					<button class="dice-btn small-btn" onclick="addDice('d100', 1)">+1d100</button>
				</div>
				<input id="selected-dice" type="text" placeholder="1d20" disabled autocomplete="off"/>
				<button class="dice-clear-btn" onclick="clearDice()">Clear</button>
			</div>
			<button
				id="roll-dice-btn"
				class={ "dice-btn", "charge-button", "selecter" }
			>
				<img src="/assets/dice/dice.png" class="bg-dice"/>
			</button>
			// <button class={ "dice-btn", "selecter" } onclick="togglePopup(this)">Hide</button>
			<div class={ popup(), "popup", "invisible" }>
				<div id="dice-box"></div>
			</div>
		</div>
	</div>
	<script type="module">
    import DiceBox from "https://unpkg.com/@3d-dice/dice-box@1.0.8/dist/dice-box.es.min.js";

    const Box = new DiceBox("#dice-box", {
        assetPath: "assets/",
        origin: "https://unpkg.com/@3d-dice/dice-box@1.0.8/dist/",
        theme: "default",
        themeColor: "#feea03",
        offscreen: false,
        scale: 5,
        // startingHeight: 1,
        // throwForce: 1,
        // spinForce: 1,
        shadow: true,
    });

    Box.init().then(() => {
        console.log("DiceBox initialized");
    });

    Box.onRollComplete = (rollResult) => {
        console.log('roll results', rollResult);
    };
    window.diceBox = Box;
    </script>
	<!---->
	<script>
    const rollButton = document.getElementById("roll-dice-btn");

    let charging = false;
    let chargeStart = 0;
    let chargeAnimation;

    const MAX_HOLD_TIME = 3000; // ms
    const MIN_FORCE = 3;
    const MAX_FORCE = 15;

    function getChargeProgress() {
        const elapsed = performance.now() - chargeStart;
        return Math.min(elapsed / MAX_HOLD_TIME, 1);
    }

    function randomJitter(power) {
        const maxOffset = power * 12; // smoother curve

        const angle = Math.random() * Math.PI * 2;
        const radius = Math.random() * maxOffset;

        const x = Math.cos(angle) * radius;
        const y = Math.sin(angle) * radius;

        rollButton.style.setProperty("--jitter-x", x + "px");
        rollButton.style.setProperty("--jitter-y", y + "px");
    }

    function updateChargeVisual() {
        const progress = getChargeProgress();
        const hue = (1 - progress) * 120;

        rollButton.style.setProperty("--progress", progress * 100);
        rollButton.style.setProperty("--hue", hue);
        randomJitter(progress);
        chargeAnimation = requestAnimationFrame(updateChargeVisual);
    }

    function startCharging(e) {
        e.preventDefault();

        charging = true;
        chargeStart = performance.now();

        rollButton.classList.add("charging");

        updateChargeVisual();
    }

    function releaseThrow(e) {
        if (!charging) return;

        charging = false;

        cancelAnimationFrame(chargeAnimation);

        rollButton.classList.remove("charging");
        rollButton.style.backgroundColor = "";

        const progress = getChargeProgress();

        const force =
            MIN_FORCE +
            (MAX_FORCE - MIN_FORCE) * progress;

        window.diceBox.updateConfig({
            startingHeight: force,
            throwForce: force,
            spinForce: force,
        });

        showPopup(rollButton);

        const rolls = [];
        for (const [diceType, amount] of Object.entries(selectedDice)) {
            rolls.push(`${amount}d${diceType}`);
        }
        window.diceBox.roll(rolls);

        console.log("Throw force:", force.toFixed(2));
    }

    rollButton.addEventListener("mousedown", startCharging);
    rollButton.addEventListener("mouseup", releaseThrow);
    rollButton.addEventListener("mouseleave", releaseThrow);

    rollButton.addEventListener("touchstart", startCharging, {
        passive: false
    });

    rollButton.addEventListener("touchend", releaseThrow);
    rollButton.addEventListener("touchcancel", releaseThrow);
    </script>
}
