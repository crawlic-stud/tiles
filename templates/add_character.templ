package templates

css characterPicker() {
	display: grid;
	grid-template-columns: repeat(5, 100px);
	gap: 8px;
	max-height: 160px;
	overflow-y: auto;
	justify-content: start;
	align-content: start;
}

css presetItem(image string) {
	width: 100px;
	height: 100px;
	background-size: cover;
	background-position: center;
	border-radius: 6px;
	cursor: pointer;
	margin: 8px;
}

css characterPreview() {
	max-width: 100px;
	max-height: 100px;
	border-radius: 6px;
	background-size: cover;
	background-position: center;
	margin-top: 8px;
}

templ AddCharacterForm(gameID int64, presets []string) {
	<div data-popup-wrapper class={ popupWrapper() }>
		<button
			class={ navButton(true) }
			onclick="togglePopup(this)"
		>
			Add Character
		</button>
		<div class={ popup(), "popup" }>
			<label class={ popupItem() }>
				<span>Name</span>
				<input id="character-name" type="text" value="Hero"/>
			</label>
			<label class={ popupItem() }>
				<span>Type</span>
				<select id="character-type">
					<option value="Hero">Hero</option>
					<option value="Enemy">Enemy</option>
					<option value="NPC">NPC</option>
				</select>
			</label>
			<label class={ popupItem() }>
				<span>Scale</span>
				<input id="character-scale" type="number" step="0.1" value="1" max="5" min="0.5"/>
			</label>
			<label class={ popupItem() }>
				<span>Image</span>
				<input id="character-image" type="file" accept="image/*" autocomplete="off"/>
				<div id="character-preview" class={ characterPreview() }></div>
			</label>
			<label class={ popupItem() }>
				<span>Presets</span>
				<div id="character-picker" class={ characterPicker() }>
					for _, preset := range presets {
						<div class={ presetItem(preset) } data-url={ preset } onclick="selectCharacterPreset(this)">
							<img
								src={ preset }
								class={ characterImage() }
							/>
						</div>
					}
				</div>
			</label>
			<button
				class={ navButton(true) }
				onclick="createCharacter()"
			>
				Add
			</button>
		</div>
	</div>
	<script>
	let selectedPresetUrl = {{ presets[0] }};
	let uploadedImageUrl = "";
	
	function selectCharacterPreset(el) {
		selectedPresetUrl = el.dataset.url;

		// clear upload state
		uploadedImageUrl = "";
		const input = document.getElementById("character-image");
		input.value = "";

		// clear preview
		const preview = document.getElementById("character-preview");
		if (preview) preview.style.backgroundImage = "";

		// UI selection
		document.querySelectorAll("#character-picker [data-url]").forEach(item => {
			item.classList.remove("selected");
		});

		el.classList.add("selected");

		console.log("Selected preset:", selectedPresetUrl);
	}

	document.getElementById("character-image").addEventListener("change", async (e) => {
		const file = e.target.files?.[0];
		if (!file) return;

		// clear preset selection
		selectedPresetUrl = "";
		document.querySelectorAll("#character-picker [data-url]").forEach(item => {
			item.classList.remove("selected");
		});

		// local preview immediately
		const preview = document.getElementById("character-preview");
		const localUrl = URL.createObjectURL(file);
		preview.style.backgroundImage = `url('${localUrl}')`;
	});

	async function createCharacter() {
		try {
			const name = document.getElementById("character-name").value;
			const type = document.getElementById("character-type").value;
			const scale = Number(document.getElementById("character-scale").value);
			const imageInput = document.getElementById("character-image");

			let image = "";

			if (imageInput?.files?.length > 0) {
				image = await uploadImage(imageInput.files[0]);
			}

			const payload = {
				gameID: {{ gameID }},
				character: {
					id: 0,
					name: name,
					type: type,
					scale: scale,
					image: image ? image : selectedPresetUrl,
				},
			};

			console.log("Create character payload:", payload);

			const response = await fetch(`/games/characters`, {
				method: "POST",
				headers: {
					"Content-Type": "application/json",
				},
				body: JSON.stringify(payload),
			});

			if (!response.ok) {
				const text = await response.text().catch(() => "");
				throw new Error("Failed to create character: " + text);
			}

			const data = await response.json();

			console.log("Character created:", data);

		} catch (err) {
			console.error(err);
			alert(err.message);
		}
	}
	</script>
}
